<?xml version="1.0" encoding="UTF-8"?>
<!--
    web.config — IIS Configuration for Nami Portfolio
    Place this in your site root (same folder as index.html)
    
    Required: Enable IIS on your Windows Server first:
    Server Manager → Add Roles → Web Server (IIS)
-->
<configuration>
    <system.webServer>

        <!-- ── Default Documents ────────────────────── -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
                <add value="mobile.html" />
            </files>
        </defaultDocument>

        <!-- ── MIME Types for JS Modules & PWA ──────── -->
        <staticContent>
            <remove fileExtension=".js" />
            <mimeMap fileExtension=".js"       mimeType="application/javascript" />
            <mimeMap fileExtension=".mjs"      mimeType="application/javascript" />
            <mimeMap fileExtension=".json"     mimeType="application/json" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <mimeMap fileExtension=".woff2"    mimeType="font/woff2" />
            <mimeMap fileExtension=".woff"     mimeType="font/woff" />
        </staticContent>

        <!-- ── Security Headers ─────────────────────── -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options"   value="nosniff" />
                <add name="X-Frame-Options"           value="SAMEORIGIN" />
                <add name="Referrer-Policy"           value="strict-origin-when-cross-origin" />
                <!-- Allow service worker scope -->
                <add name="Service-Worker-Allowed"    value="/" />
            </customHeaders>
        </httpProtocol>

        <!-- ── Caching Rules ────────────────────────── -->
        <caching enabled="true" enableKernelCache="true">
            <!-- HTML: no cache (always fresh) -->
            <profiles>
                <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
                <!-- JS/CSS: cache 1 hour (version strings handle busting) -->
                <add extension=".js"   policy="CacheForTimePeriod" kernelCachePolicy="CacheForTimePeriod" duration="01:00:00" />
                <add extension=".css"  policy="CacheForTimePeriod" kernelCachePolicy="CacheForTimePeriod" duration="01:00:00" />
                <!-- Images: cache 1 week -->
                <add extension=".png"  policy="CacheForTimePeriod" kernelCachePolicy="CacheForTimePeriod" duration="7.00:00:00" />
            </profiles>
        </caching>

        <!-- ── Compression ──────────────────────────── -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- ── Error Pages ──────────────────────────── -->
        <httpErrors errorMode="Custom">
            <remove statusCode="404" />
            <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
        </httpErrors>

    </system.webServer>
</configuration>
